# Copy to .env. Replace all CHANGE_ME values; never commit .env.
POSTGRES_DB=dean
POSTGRES_USER=dean
POSTGRES_PASSWORD=CHANGE_ME_DATABASE_PASSWORD
Demo__Enabled=true
Demo__Password1=CHANGE_ME_STRONG_UNIQUE_PASSWORD_1
Demo__Password2=CHANGE_ME_STRONG_UNIQUE_PASSWORD_2
Demo__StaffPassword=CHANGE_ME_STRONG_UNIQUE_STAFF_PASSWORD
# Local HTTPS; production: dean.example.org
SITE_ADDRESS=https://localhost
# Private Compose network; change both together if this subnet conflicts with a VPN.
COMPOSE_SUBNET=172.29.238.0/24
PROXY_ADDRESS=172.29.238.10
